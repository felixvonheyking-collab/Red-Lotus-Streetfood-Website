# Zeichensatz im HTTP-Header mitsenden (nicht nur im <meta>)
AddDefaultCharset UTF-8
AddType "text/html; charset=UTF-8" .html
AddType "text/plain; charset=UTF-8" .txt
AddType "application/xml; charset=UTF-8" .xml

# Interne Arbeitsdateien nicht öffentlich ausliefern (Sicherheits-/
# Rechtscheck 25.08.2026). Die Dateien bleiben im Repo, sie werden für
# die Arbeit am Projekt gebraucht — nur der Webzugriff wird gesperrt.
# llms.txt, robots.txt und sitemap.xml bleiben bewusst öffentlich.
RedirectMatch 404 ^/(DESIGN|DESIGN-PLAN|PRODUCT|LIVE-SCHALTUNG_DNS)\.md$
RedirectMatch 404 ^/(tools|referenzen|\.impeccable|\.github)/

# http -> https (kanonisch)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://redlotusstreetfood.com/$1 [R=301,L]
# www -> ohne www (kanonisch, wie redlotus-asianfood.com)
RewriteCond %{HTTP_HOST} ^www\.redlotusstreetfood\.com$ [NC]
RewriteRule ^(.*)$ https://redlotusstreetfood.com/$1 [R=301,L]
# /index.html -> / (saubere Adresszeile)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Browser-Caching: Bilder/Fonts lange, HTML immer frisch
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
</IfModule>

# Kompression für Text-Inhalte
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Sicherheits-Header (Sicherheits-/Rechtscheck 25.08.2026)
# Die Content-Security-Policy ist auf den tatsächlichen Bestand der Seite
# zugeschnitten und muss bei neuen externen Einbindungen mitwachsen:
#   - script-src/style-src 'unsafe-inline': die Seite arbeitet mit
#     Inline-<style>- und Inline-<script>-Blöcken (kein externes JS/CSS).
#   - img-src data:: Event-Poster aus Firestore kommen als data:-URIs.
#   - connect-src firestore.googleapis.com: Wochenkarte, Hinweis-Banner
#     und Aktuelles-Sektion per REST.
#   - connect-src wixformwebhook-…run.app: Ziel des Buchungsformulars.
# Schriften liegen lokal (font-src 'self'), es gibt keine iframes und
# keine weiteren externen Quellen.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://firestore.googleapis.com https://wixformwebhook-e6seurotja-ew.a.run.app; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
